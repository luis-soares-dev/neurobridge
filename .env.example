# ──────────────────────────────────────────────────────────────────────────────
# NeuroBridge — Variáveis de Ambiente
# ──────────────────────────────────────────────────────────────────────────────
# COMO USAR:
#   1. Copie este arquivo: cp .env.example .env.local
#   2. Preencha os valores do seu projeto Supabase
#   3. NUNCA suba o .env.local para o GitHub (já está no .gitignore)
# ──────────────────────────────────────────────────────────────────────────────

# Supabase — obtenha em: https://supabase.com → seu projeto → Settings → API
VITE_SUPABASE_URL=https://XXXXXXXXXXXXX.supabase.co
VITE_SUPABASE_ANON_KEY=eyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Ambiente (development | production)
VITE_APP_ENV=development
