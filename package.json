{
  "name": "neurobridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest --run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run test:run && npm run build",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.13",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "18.3.5",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "typescript": "5.5.3",
    "typescript-eslint": "8.72.1",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}
